# HTTPS virtual host for staging/production (served by jonasal/nginx-certbot).
# Source of truth in git. scripts/setup-vps.sh generates nginx/conf.d/default.conf on every run via
#   export DOMAIN=<from .env>; envsubst '${DOMAIN}' < default.conf.template > default.conf
# It does NOT delete this template. jonasal may rename default.conf to .nokey until a cert exists;
# setup also removes stale .nokey and recreates nginx so certbot can issue to live/<DOMAIN>/ .
# HTTP for ACME is handled by 00-acme.conf.
#
# Portainer CE is not proxied here — use https://127.0.0.1:9443 on the host (loopback only).
#
# Docker embedded DNS. Upstream DNS refresh needs resolver + upstream zone + server ... resolve (nginx >= 1.27.3 OSS).
resolver 127.0.0.11 valid=10s ipv6=off;

upstream web_app {
    zone web_app 64k;

    server web:3000 resolve;
}

upstream notifications_app {
    zone notifications_app 64k;

    server notifications:7200 resolve;
}

upstream ipfs_gateway_app {
    zone ipfs_gateway_app 64k;

    server ipfs-gateway:7300 resolve;
}

upstream query_api_app {
    zone query_api_app 64k;

    server query-api:7000 resolve;
}

upstream knowledge_api_app {
    zone knowledge_api_app 64k;

    server knowledge-api:7400 resolve;
}

upstream auth_api_app {
    zone auth_api_app 64k;

    server auth-api:7100 resolve;
}

upstream vip_tickets_app {
    zone vip_tickets_app 64k;

    server vip-tickets:7611 resolve;
}

# MCP endpoints accept GET, so an agent probing the URL learns what it is instead of a bare 403.
# knowledge-api (/mcp) and query-api (/query/mcp) answer GET themselves. vip-tickets has no
# source in this repo, so nginx answers its GET: Accept text/event-stream (an MCP client asking
# for an SSE stream) -> 405 per MCP spec; any other GET/HEAD -> 200 markdown guide.
# See docs/deployment/mcp-endpoints.md
map "$request_method:$http_accept" $vip_tickets_mcp_get {
    default                       "";
    "~*^GET:.*text/event-stream"  sse;
    "~^(GET|HEAD):"               guide;
}

# Per-IP rate limit for auth challenge/verify endpoints
limit_req_zone $binary_remote_addr zone=auth_api_limit:10m rate=10r/s;

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 30m;

    location /notifications/ws {
        proxy_pass http://notifications_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location = /query/mcp {
        limit_except GET POST OPTIONS { deny all; }
        proxy_pass http://query_api_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # knowledge-api MCP lives at the site root. The old /knowledge/mcp path is gone.
    location = /mcp {
        limit_except GET POST OPTIONS { deny all; }
        proxy_pass http://knowledge_api_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location = /vip-tickets/mcp {
        limit_except GET POST OPTIONS { deny all; }
        error_page 418 = @vip_tickets_mcp_sse;
        error_page 419 = @vip_tickets_mcp_guide;
        if ($vip_tickets_mcp_get = sse) {
            return 418;
        }
        if ($vip_tickets_mcp_get = guide) {
            return 419;
        }
        proxy_pass http://vip_tickets_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location @vip_tickets_mcp_sse {
        default_type application/json;
        add_header Allow POST always;
        return 405 '{"jsonrpc":"2.0","error":{"code":-32000,"message":"Method not allowed: stateless MCP server, no SSE stream. Send JSON-RPC with POST to this URL."},"id":null}';
    }

    location @vip_tickets_mcp_guide {
        default_type "text/markdown; charset=utf-8";
        add_header X-Robots-Tag noindex always;
        return 200 '# VIP tickets MCP server

You opened https://${DOMAIN}/vip-tickets/mcp with GET. This URL is an MCP server (Model Context Protocol, Streamable HTTP), not a web page or REST API. Nothing is wrong: send JSON-RPC 2.0 requests to this same URL with POST.

## Connect an MCP client

```json
{ "mcpServers": { "vip-tickets": { "url": "https://${DOMAIN}/vip-tickets/mcp" } } }
```

Claude Code: `claude mcp add --transport http vip-tickets https://${DOMAIN}/vip-tickets/mcp`

## Call it without an MCP client

Every request: `POST`, `Content-Type: application/json`, `Accept: application/json, text/event-stream` (without `text/event-stream` the server answers 406). Start with the `initialize` method; its result carries the server instructions. Then `tools/list` and `tools/call`.

## Related MCP servers

- Docs, specs and skills (knowledge): https://${DOMAIN}/mcp
- Live platform data: https://${DOMAIN}/query/mcp
';
    }

    # ipfs-gateway (content/namespaces public; upload JWT in app)
    location /ipfs-gateway/ {
        proxy_pass http://ipfs_gateway_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 55m;
    }

    # auth-api (public challenge/verify only after security hardening)
    location /auth/ {
        limit_except GET POST { deny all; }
        limit_req zone=auth_api_limit burst=20 nodelay;
        client_max_body_size 64k;
        proxy_pass http://auth_api_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # vip-tickets (health GET, redeem POST; MCP is the exact location above)
    location /vip-tickets/ {
        limit_except GET POST { deny all; }
        client_max_body_size 64k;
        proxy_pass http://vip_tickets_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_pass http://web_app;
    }
}
