{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": ".claude/plans",
  "permissions": {
    "allow": [
      "Bash(pnpm nx lint:*)",
      "Bash(pnpm nx test:*)",
      "Bash(pnpm nx typecheck:*)",
      "Bash(pnpm nx build:*)",
      "Bash(pnpm nx run-many:*)",
      "Bash(pnpm nx affected:*)",
      "Bash(pnpm nx show:*)",
      "Bash(pnpm nx graph:*)",
      "Bash(pnpm nx format:check*)",
      "Bash(pnpm check*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm verify:deps)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -- *)"
    ],
    "ask": ["Bash(git commit:*)", "Bash(git push:*)"],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)"
    ]
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["/tmp/.nx", "~/.nx"],
      "allowWrite": ["/tmp/.nx", "~/.nx"]
    },
    "network": {
      "allowUnixSockets": ["/tmp/.nx", "~/.nx"]
    }
  }
}
