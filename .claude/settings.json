{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
      "allow": [
        "Bash(pnpm nx lint:*)",
        "Bash(pnpm nx test:*)",
        "Bash(pnpm nx typecheck:*)",
        "Bash(pnpm nx build:*)",
        "Bash(pnpm nx run-many:*)",
        "Bash(pnpm nx affected:*)",
        "Bash(pnpm nx show:*)",
        "Bash(pnpm nx graph:*)",
        "Bash(pnpm nx format:check*)",
        "Bash(pnpm check*)",
        "Bash(pnpm typecheck*)",
        "Bash(pnpm verify:deps)",
        "Bash(git status:*)",
        "Bash(git diff:*)",
        "Bash(git log:*)",
        "Bash(git show:*)",
        "Bash(git branch:*)"
      ],
      "ask": [
        "Bash(git commit:*)",
        "Bash(git push:*)"
      ],
      "deny": [
        "Read(./.env)",
        "Read(./**/.env)",
        "Read(./.env.local)",
        "Read(./**/.env.local)"
      ]
    }
  }